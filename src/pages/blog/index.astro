---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { postDate, postSlug, publishedPosts } from "../../lib/posts";

const posts = publishedPosts(await getCollection("posts"));
---

<Layout title="Blog | alasdair.md" canonical="https://alasdair.md/blog/">
	<div class="wrapper">
		<h1>Blog</h1>
		<ul class="item-list">
			{
				posts.map((post) => (
					<li>
						<a href={`/blog/${postSlug(post)}/`}>
							<h2>{post.data.description ?? post.id}</h2>
							<p>
								{postDate(post.data.date).toLocaleDateString(
									"en-GB",
									{
										timeZone: "UTC",
										year: "numeric",
										month: "long",
										day: "numeric",
									},
								)}
							</p>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</Layout>
